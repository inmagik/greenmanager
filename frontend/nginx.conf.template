# A template of the nginx image: at the start ${NGINX_LOCAL_RESOLVERS} becomes the DNS of the container (Dockerfile).

# The orthophoto of the Portale Cartografico Nazionale, only on HTTP: served through the proxy under /wms/pcn, so an
# application on HTTPS loads it, and kept in a cache, since the service is slow and the images do not change.
proxy_cache_path /var/cache/nginx/wms levels=1:2 keys_zone=wms:10m max_size=2g inactive=30d use_temp_path=off;

# A WMS gives its errors as XML with status 200: only the images go in the cache.
map $upstream_http_content_type $wms_no_cache {
  ~^image/ 0;
  default 1;
}

server {
  charset utf-8;
  listen 80;
  root /var/www;

  server_tokens off;

  gzip on;

  location /wms/pcn {
    # The name is resolved at each request, not at the start: without DNS, or with the service down, only the
    # orthophoto fails, and nginx starts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
    set $pcn_host wms.pcn.minambiente.it;
    proxy_pass http://$pcn_host/ogc$is_args$args;
    proxy_set_header Host $pcn_host;
    proxy_cache wms;
    proxy_cache_valid 200 30d;
    proxy_no_cache $wms_no_cache;
    proxy_cache_use_stale error timeout updating;
  }

  location / {
    try_files $uri /index.html;
    # Prevent caching for HTML files only
    location ~* \.html$ {
      add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
  }
}